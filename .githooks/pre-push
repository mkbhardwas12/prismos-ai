#!/usr/bin/env bash
set -euo pipefail

remote_name="${1:-}"
repo_root="$(git rev-parse --show-toplevel)"
checker="${repo_root}/scripts/check-public-boundary.sh"
cd "${repo_root}"

if [[ ! -x "${checker}" ]]; then
  echo "PrismOS pre-push boundary checker is missing or not executable." >&2
  exit 1
fi

is_zero_oid() {
  [[ "$1" =~ ^(0{40}|0{64})$ ]]
}

is_object_oid() {
  [[ "$1" =~ ^([0-9a-f]{40}|[0-9a-f]{64})$ ]]
}

destination_oids_temp="$(mktemp)"
commits_temp="$(mktemp)"
remotes_temp="$(mktemp)"
cleanup() {
  rm -f -- "${destination_oids_temp}" "${commits_temp}" "${remotes_temp}"
}
trap cleanup EXIT

# New branches are compared only with refs known to belong to the destination
# remote. A commit present on some unrelated remote must still be scanned.
: > "${destination_oids_temp}"
git remote > "${remotes_temp}"
remote_is_configured=0
set +e
LC_ALL=C grep -F -x -q -- "${remote_name}" "${remotes_temp}"
grep_rc=$?
set -e
case "${grep_rc}" in
  0) remote_is_configured=1 ;;
  1) ;;
  *)
    echo "Could not identify the destination remote; failing closed." >&2
    exit 1
    ;;
esac
if [[ "${remote_is_configured}" == "1" ]]; then
  git for-each-ref --format='%(objectname)' "refs/remotes/${remote_name}/" > "${destination_oids_temp}"
fi

total_checked=0
while read -r local_ref local_oid remote_ref remote_oid; do
  [[ -n "${local_oid:-}" ]] || continue
  if ! is_object_oid "${local_oid}" || ! is_object_oid "${remote_oid}"; then
    echo "Pre-push received an invalid Git object ID; failing closed." >&2
    exit 1
  fi
  if is_zero_oid "${local_oid}"; then
    continue
  fi

  object_type="$(git cat-file -t "${local_oid}")"
  snapshot_ref="${local_ref}"$'\n'"${remote_ref}"
  ref_checked=0
  case "${object_type}" in
    tag)
      # This scans the tag message and the peeled commit/tree. Tags of blobs or
      # trees are deliberately rejected because they bypass commit snapshots.
      PRISMOS_SNAPSHOT_REF="${snapshot_ref}" bash "${checker}" --treeish "${local_oid}"
      ref_checked=1
      total_checked=$((total_checked + 1))
      if ! peeled_local="$(git rev-parse --verify "${local_oid}^{commit}" 2>/dev/null)"; then
        echo "PrismOS public pushes do not allow tags that do not peel to commits." >&2
        exit 1
      fi
      ;;
    commit)
      peeled_local="${local_oid}"
      ;;
    *)
      echo "PrismOS public pushes only allow commit refs and tags of commits." >&2
      exit 1
      ;;
  esac

  rev_args=("${peeled_local}")
  if is_zero_oid "${remote_oid}"; then
    while IFS= read -r destination_oid; do
      [[ -n "${destination_oid}" ]] || continue
      if ! is_object_oid "${destination_oid}" || is_zero_oid "${destination_oid}"; then
        echo "Destination remote-tracking ref has an invalid object ID; failing closed." >&2
        exit 1
      fi
      rev_args+=("^${destination_oid}")
    done < "${destination_oids_temp}"
  else
    if ! git cat-file -e "${remote_oid}^{commit}" 2>/dev/null; then
      echo "Remote range endpoint is not locally available; failing closed." >&2
      exit 1
    fi
    rev_args+=("^${remote_oid}")
  fi

  git rev-list --reverse "${rev_args[@]}" > "${commits_temp}"
  while IFS= read -r commit; do
    [[ -n "${commit}" ]] || continue
    if ! is_object_oid "${commit}"; then
      echo "git rev-list returned an invalid object ID; failing closed." >&2
      exit 1
    fi
    echo "Checking an outgoing PrismOS commit snapshot."
    PRISMOS_SNAPSHOT_REF="${snapshot_ref}" bash "${checker}" --treeish "${commit}"
    ref_checked=1
    total_checked=$((total_checked + 1))
  done < "${commits_temp}"

  # A new lightweight tag or force-push may point entirely at commits already
  # present on the destination. Still scan its ref name and exact target.
  if [[ "${ref_checked}" -eq 0 ]]; then
    PRISMOS_SNAPSHOT_REF="${snapshot_ref}" bash "${checker}" --treeish "${peeled_local}"
    total_checked=$((total_checked + 1))
  fi
done

if [[ "${total_checked}" -eq 0 ]]; then
  echo "No newly exposed commit/tag snapshots required a PrismOS boundary scan."
fi
